# BasicScenarioFlow

main: kit: flow: BasicScenarioFlow:
{
  entity: "scenario",
  kind: "basic",
  name: "BasicScenarioFlow",
  step: [
    {
      i: {
        ref: "scenario_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "scenario_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "scenario_ref01",
        srcdatavar: "scenario_ref01_data",
        suffix: "_up0",
        textfield: "createdAt"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-scenario_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "scenario_ref01",
        srcdatavar: "scenario_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "scenario01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-scenario_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "scenario_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "scenario01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "scenario_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicScenarioFlow"
}