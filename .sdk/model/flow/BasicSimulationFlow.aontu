# BasicSimulationFlow

main: kit: flow: BasicSimulationFlow:
{
  entity: "simulation",
  kind: "basic",
  name: "BasicSimulationFlow",
  step: [
    {
      i: {
        ref: "simulation_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "simulation_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "simulation_ref01",
        srcdatavar: "simulation_ref01_data",
        suffix: "_up0",
        textfield: "assistantId"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-simulation_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "simulation_ref01",
        srcdatavar: "simulation_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-simulation_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "simulation_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "simulation01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "simulation_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSimulationFlow"
}