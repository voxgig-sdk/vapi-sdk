# BasicFileFlow

main: kit: flow: BasicFileFlow:
{
  entity: "file",
  kind: "basic",
  name: "BasicFileFlow",
  step: [
    {
      i: {
        ref: "file_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "file_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "file_ref01",
        srcdatavar: "file_ref01_data",
        suffix: "_up0",
        textfield: "bucket"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-file_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "file_ref01",
        srcdatavar: "file_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "file01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-file_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "file_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "file01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "file_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicFileFlow"
}