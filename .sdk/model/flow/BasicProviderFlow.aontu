# BasicProviderFlow

main: kit: flow: BasicProviderFlow:
{
  entity: "provider",
  kind: "basic",
  name: "BasicProviderFlow",
  step: [
    {
      i: {
        ref: "provider_ref01"
      }

      m: {
        provider: "provider01",
        resource_name: "resource_name01"
      }

      o: "create"
    }

    {
      d: {
        provider: "provider01",
        resource_name: "resource_name01"
      }

      i: {
        ref: "provider_ref01",
        srcdatavar: "provider_ref01_data",
        suffix: "_up0",
        textfield: "createdAt"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-provider_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "provider_ref01",
        srcdatavar: "provider_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "provider01",
        provider: "provider01",
        resource_name: "resource_name01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-provider_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "provider_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "provider01",
        provider: "provider01",
        resource_name: "resource_name01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicProviderFlow"
}