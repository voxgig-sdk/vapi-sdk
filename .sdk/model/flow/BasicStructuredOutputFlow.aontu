# BasicStructuredOutputFlow

main: kit: flow: BasicStructuredOutputFlow:
{
  entity: "structured_output",
  kind: "basic",
  name: "BasicStructuredOutputFlow",
  step: [
    {
      i: {
        ref: "structured_output_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "structured_output_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "structured_output_ref01",
        srcdatavar: "structured_output_ref01_data",
        suffix: "_up0",
        textfield: "createdAt"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-structured_output_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "structured_output_ref01",
        srcdatavar: "structured_output_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "structured_output01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-structured_output_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "structured_output_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "structured_output01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "structured_output_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicStructuredOutputFlow"
}