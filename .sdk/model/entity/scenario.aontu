# Entity: scenario

main: kit: entity: scenario: {

  alias: field: {}

  fields: {
    createdAt: {
      fo: "date-time"
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "This is the ISO 8601 date-time string of when the scenario was created."
      t: "`$STRING`"
    }
    evaluations: {
      h: "Evaluations"
      n: "evaluations"
      op: {
        update: {
          req: false
          type: "`$ARRAY`"
        }
      }
      r: true
      sh: "This is the structured output-based evaluation plan for the simulation."
      t: "`$ARRAY`"
      union: {
        branches: 5
        count: 3
        depth: 8
      }
    }
    hooks: {
      h: "Hooks"
      n: "hooks"
      r: false
      sh: "Hooks to run on simulation lifecycle events"
      t: "`$ARRAY`"
      union: {
        branches: 2
        count: 1
        depth: 1
      }
    }
    id: {
      fo: "uuid"
      h: "Id"
      n: "id"
      r: true
      sh: "This is the unique identifier for the scenario."
      t: "`$STRING`"
    }
    instructions: {
      h: "Instructions"
      n: "instructions"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "This is the script/instructions for the tester to follow during the simulation."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "This is the name of the scenario."
      t: "`$STRING`"
    }
    orgId: {
      fo: "uuid"
      h: "Org Id"
      n: "orgId"
      r: true
      sh: "This is the unique identifier for the organization this scenario belongs to."
      t: "`$STRING`"
    }
    path: {
      h: "Path"
      n: "path"
      r: false
      sh: "Optional folder path for organizing scenarios."
      t: "`$STRING`"
    }
    targetOverrides: {
      h: "Target Overrides"
      n: "targetOverrides"
      r: false
      sh: "Overrides to inject into the simulated target assistant or squad"
      t: "`$ANY`"
      union: {
        branches: 23
        count: 5356
        depth: 42
      }
    }
    toolMocks: {
      h: "Tool Mocks"
      n: "toolMocks"
      r: false
      sh: "Scenario-level tool call mocks to use during simulations."
      t: "`$ARRAY`"
    }
    updatedAt: {
      fo: "date-time"
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "This is the ISO 8601 date-time string of when the scenario was last updated."
      t: "`$STRING`"
    }
  }

