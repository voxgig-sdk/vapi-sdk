                or: "standalone_only"
                r: false
                t: "`$BOOLEAN`"
              }
              {
                k: "query"
                n: "updated_at_ge"
                or: "updated_at_ge"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "updated_at_gt"
                or: "updated_at_gt"
                r: false
                t: "`$STRING`"
