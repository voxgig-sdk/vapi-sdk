# Entity: simulation

main: kit: entity: simulation: {

  alias: field: {}

  fields: {
    assistantId: {
      h: "Assistant Id"
      n: "assistantId"
      r: false
      sh: "ID of the assistant to generate scenarios for"
      t: "`$STRING`"
    }
    createdAt: {
      fo: "date-time"
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "This is the ISO 8601 date-time string of when the simulation was created."
      t: "`$STRING`"
    }
    id: {
      fo: "uuid"
      h: "Id"
      n: "id"
      r: true
      sh: "This is the unique identifier for the simulation."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "This is an optional friendly name for the simulation."
      t: "`$STRING`"
    }
    orgId: {
      fo: "uuid"
      h: "Org Id"
      n: "orgId"
      r: true
      sh: "This is the unique identifier for the organization this simulation belongs to."
      t: "`$STRING`"
    }
    path: {
      h: "Path"
      n: "path"
      r: false
      sh: "Optional folder path for organizing simulations."
      t: "`$STRING`"
    }
    personalityId: {
      fo: "uuid"
      h: "Personality Id"
      n: "personalityId"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "This is the ID of the personality to use for this simulation."
      t: "`$STRING`"
    }
    scenarioId: {
      fo: "uuid"
      h: "Scenario Id"
      n: "scenarioId"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "This is the ID of the scenario to use for this simulation."
      t: "`$STRING`"
    }
    squadId: {
      h: "Squad Id"
      n: "squadId"
      r: false
      sh: "ID of the squad to generate scenarios for"
      t: "`$STRING`"
    }
    updatedAt: {
      fo: "date-time"
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "This is the ISO 8601 date-time string of when the simulation was last updated."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "simulation"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /eval/simulation"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/eval/simulation"
          s: [
            {
              lit: "eval"
            }
            {
              lit: "simulation"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /eval/simulation/scenario/generate"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/eval/simulation/scenario/generate"
          s: [
            {
              lit: "eval"
            }
            {
              lit: "simulation"
            }
            {
              lit: "scenario"
            }
            {
              lit: "generate"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /eval/simulation"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
