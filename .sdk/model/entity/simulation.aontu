              "created_at_le"
              "created_at_lt"
              "id_any"
              "limit"
              "page"
              "sort_by"
              "sort_order"
              "standalone_only"
              "updated_at_ge"
              "updated_at_gt"
              "updated_at_le"
              "updated_at_lt"
            ]
          }
          s: [
            {
              lit: "eval"
            }
            {
              lit: "simulation"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /eval/simulation/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
